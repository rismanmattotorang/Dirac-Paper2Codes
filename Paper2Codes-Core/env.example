# Paper2Codes Core Backend Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# LLM API Keys (at least one required)
# =============================================================================

# OpenRouter (recommended - provides access to multiple models)
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Or use individual provider keys:
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# XAI_API_KEY=...

# =============================================================================
# API Server Configuration
# =============================================================================

# Server host and port
API_HOST=0.0.0.0
API_PORT=8080

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# API rate limits
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST_SIZE=20

# Request size limits (in bytes)
MAX_REQUEST_SIZE=10485760  # 10MB
MAX_FILE_UPLOAD_SIZE=104857600  # 100MB

# =============================================================================
# Database Configuration (SurrealDB)
# =============================================================================

# Connection URL
# For Docker: ws://surreal:8000
# For local: ws://localhost:8000
DATABASE_URL=ws://localhost:8000

# Database credentials
DATABASE_NAMESPACE=paper2codes
DATABASE_NAME=main
DATABASE_USER=root
DATABASE_PASS=root

# Connection pool settings
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=5
DATABASE_CONNECTION_TIMEOUT_SECONDS=30

# Auto-migrate schema on startup
DATABASE_AUTO_MIGRATE=true

# =============================================================================
# Authentication Configuration
# =============================================================================

# JWT secret key (generate a secure random string for production)
JWT_SECRET_KEY=your-secret-key-change-in-production

# JWT token expiration times
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# Password hashing (argon2)
PASSWORD_HASH_MEMORY_KB=65536  # 64MB
PASSWORD_HASH_ITERATIONS=3
PASSWORD_HASH_PARALLELISM=4

# =============================================================================
# LLM Configuration
# =============================================================================

# Default LLM provider
DEFAULT_LLM_PROVIDER=openai

# Model selection
PLANNING_MODEL=openai/gpt-4-turbo
ANALYSIS_MODEL=anthropic/claude-3-opus-20240229
CODING_MODEL=openai/gpt-4-turbo
VERIFICATION_MODEL=anthropic/claude-3-opus-20240229

# LLM request timeouts
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3

# Temperature settings
DEFAULT_TEMPERATURE=0.7
PLANNING_TEMPERATURE=0.8
CODING_TEMPERATURE=0.6

# =============================================================================
# Agent Configuration
# =============================================================================

# Maximum iterations for multi-agent coordination
MAX_AGENT_ITERATIONS=10

# Parallel task execution
PARALLEL_TASKS=4

# Task timeout
TASK_TIMEOUT_SECONDS=600

# =============================================================================
# Performance Configuration
# =============================================================================

# Memory profile (low, standard, high, auto)
MEMORY_PROFILE=auto

# Cache settings
ENABLE_CACHING=true
CACHE_SIZE=1000
CACHE_TTL_SECONDS=3600

# Adaptive concurrency
ADAPTIVE_CONCURRENCY_ENABLED=true
ADAPTIVE_CONCURRENCY_MIN=2
ADAPTIVE_CONCURRENCY_MAX=10

# =============================================================================
# Verification Configuration
# =============================================================================

# Enable verification phases
ENABLE_STATIC_CHECKS=true
ENABLE_DYNAMIC_TESTS=true
ENABLE_SYMBOLIC_VERIFICATION=false  # Requires Z3 solver

# Verification timeout
VERIFICATION_TIMEOUT_SECONDS=300

# =============================================================================
# Execution Configuration
# =============================================================================

# Sandbox type (docker, isolated)
SANDBOX_TYPE=docker

# Execution timeout
EXECUTION_TIMEOUT_SECONDS=300

# Resource limits
SANDBOX_MEMORY_LIMIT_MB=2048
SANDBOX_CPU_LIMIT=2.0

# =============================================================================
# GitHub Integration (optional)
# =============================================================================

# GitHub personal access token for higher rate limits
GITHUB_TOKEN=

# Enable GitHub repository integration
GITHUB_INTEGRATION_ENABLED=true
GITHUB_MAX_REPOS=3

# =============================================================================
# Monitoring and Observability
# =============================================================================

# Logging level (trace, debug, info, warn, error)
LOG_LEVEL=info

# Structured logging format (json, pretty)
LOG_FORMAT=pretty

# Enable metrics endpoint
METRICS_ENABLED=true
METRICS_PORT=9090

# Enable tracing
TRACING_ENABLED=false
TRACING_ENDPOINT=http://localhost:14268/api/traces

# Sentry error tracking (optional)
SENTRY_DSN=

# =============================================================================
# Storage Configuration
# =============================================================================

# File storage path
STORAGE_PATH=./data

# Temporary file path
TEMP_PATH=./tmp

# Maximum storage size (bytes)
MAX_STORAGE_SIZE=10737418240  # 10GB

# =============================================================================
# Feature Flags
# =============================================================================

# Enable/disable features
FEATURE_DOMAIN_DETECTION=true
FEATURE_GITHUB_INTEGRATION=true
FEATURE_SYMBOLIC_VERIFICATION=false
FEATURE_ITERATIVE_AGENTS=true
FEATURE_HIERARCHICAL_EVALUATION=true

# =============================================================================
# Security Configuration
# =============================================================================

# Enable security features
SECURITY_HEADERS_ENABLED=true
CSRF_PROTECTION_ENABLED=true
INPUT_VALIDATION_STRICT=true

# Trusted proxy headers
TRUST_PROXY_HEADERS=false

# =============================================================================
# Development Configuration
# =============================================================================

# Enable development mode
DEV_MODE=false

# Enable debug logging
DEBUG=false

# Enable hot reload
HOT_RELOAD=false

# =============================================================================
# Production Configuration
# =============================================================================

# Environment (development, staging, production)
ENVIRONMENT=development

# Service name
SERVICE_NAME=paper2codes-core

# Service version
SERVICE_VERSION=0.1.0

# =============================================================================
# Advanced Configuration
# =============================================================================

# Worker threads (default: number of CPU cores)
WORKER_THREADS=

# Max blocking threads
MAX_BLOCKING_THREADS=512

# Enable experimental features
EXPERIMENTAL_FEATURES=false

