# Paper2Codes WebUI Configuration
# Copy this file to .env.local and fill in your values

# =============================================================================
# Backend API Configuration
# =============================================================================

# Backend API URL
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080

# WebSocket URL
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8080/ws

# API timeout (milliseconds)
NEXT_PUBLIC_API_TIMEOUT=30000

# =============================================================================
# Application Configuration
# =============================================================================

# Application title
NEXT_PUBLIC_APP_TITLE=Paper2Codes

# Application description
NEXT_PUBLIC_APP_DESCRIPTION=Automated Code Generation from Scientific Papers

# Application version
NEXT_PUBLIC_APP_VERSION=0.1.0

# =============================================================================
# Authentication Configuration
# =============================================================================

# Enable authentication
NEXT_PUBLIC_AUTH_ENABLED=true

# Authentication provider
NEXT_PUBLIC_AUTH_PROVIDER=jwt

# Token storage (localStorage, sessionStorage, cookie)
NEXT_PUBLIC_TOKEN_STORAGE=cookie

# =============================================================================
# Feature Flags
# =============================================================================

# Enable features
NEXT_PUBLIC_FEATURE_ANALYTICS=true
NEXT_PUBLIC_FEATURE_REALTIME_UPDATES=true
NEXT_PUBLIC_FEATURE_FILE_UPLOAD=true
NEXT_PUBLIC_FEATURE_CODE_GENERATION=true
NEXT_PUBLIC_FEATURE_VERIFICATION=true
NEXT_PUBLIC_FEATURE_SEARCH=true

# =============================================================================
# UI Configuration
# =============================================================================

# Default theme (light, dark, system)
NEXT_PUBLIC_DEFAULT_THEME=system

# Enable theme switcher
NEXT_PUBLIC_ENABLE_THEME_SWITCHER=true

# Enable animations
NEXT_PUBLIC_ENABLE_ANIMATIONS=true

# =============================================================================
# Real-time Configuration
# =============================================================================

# WebSocket reconnection settings
NEXT_PUBLIC_WS_RECONNECT_ENABLED=true
NEXT_PUBLIC_WS_RECONNECT_INTERVAL=5000
NEXT_PUBLIC_WS_MAX_RECONNECT_ATTEMPTS=10

# Polling fallback (if WebSocket fails)
NEXT_PUBLIC_POLLING_ENABLED=true
NEXT_PUBLIC_POLLING_INTERVAL=5000

# =============================================================================
# Upload Configuration
# =============================================================================

# Maximum file upload size (bytes)
NEXT_PUBLIC_MAX_UPLOAD_SIZE=104857600  # 100MB

# Allowed file types
NEXT_PUBLIC_ALLOWED_FILE_TYPES=.pdf,.txt,.md

# =============================================================================
# Pagination Configuration
# =============================================================================

# Default page size
NEXT_PUBLIC_DEFAULT_PAGE_SIZE=20

# Page size options
NEXT_PUBLIC_PAGE_SIZE_OPTIONS=10,20,50,100

# =============================================================================
# Monitoring and Analytics
# =============================================================================

# Enable client-side monitoring
NEXT_PUBLIC_MONITORING_ENABLED=false

# Sentry DSN (optional)
NEXT_PUBLIC_SENTRY_DSN=

# Google Analytics ID (optional)
NEXT_PUBLIC_GA_ID=

# =============================================================================
# Development Configuration
# =============================================================================

# Enable development mode
NEXT_PUBLIC_DEV_MODE=true

# Enable debug logging
NEXT_PUBLIC_DEBUG=false

# Show development tools
NEXT_PUBLIC_SHOW_DEV_TOOLS=true

# =============================================================================
# Build Configuration
# =============================================================================

# Build output directory
BUILD_DIR=.next

# Enable source maps in production
GENERATE_SOURCEMAP=false

# Enable bundle analysis
ANALYZE_BUNDLE=false

# =============================================================================
# Server Configuration (Next.js Server)
# =============================================================================

# Server port
PORT=3000

# Server host
HOSTNAME=localhost

# =============================================================================
# Environment
# =============================================================================

# Environment (development, staging, production)
NODE_ENV=development
